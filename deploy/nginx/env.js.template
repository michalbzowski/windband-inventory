// windband-inventory — runtime environment, rendered by nginx envsubst at
// container start (nginx:alpine turns /etc/nginx/templates/*.template into
// served files). Values come from the container environment; defaults live in
// the Dockerfile ENV lines so this file always renders with defined values.
// DO NOT rename the placeholder names — production supplies AUTH_ISSUER and
// AUTH_CLIENT_ID as ordinary environment/service variables.
window.__WI_ENV__ = {
  "authIssuer": "${AUTH_ISSUER}",
  "clientId": "${AUTH_CLIENT_ID}"
};
