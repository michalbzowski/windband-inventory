# windband-inventory — default server (nginx:alpine auto-renders this via
# envsubst at container start; placeholders are $-variables from the container
# environment). Serves the built SPA and reverse-proxies same-origin /api/v1
# to windband-manager, mirroring the vite dev proxy used locally.

server {
    # Explicit bind: do not depend on nginx's OS-default socket location. If a
    # future base-image upgrade ever ships a non-standard compile, this line is
    # the only thing that keeps the container listening on port 80 for Railway.
    listen 0.0.0.0:80;
    listen [::]:80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Built assets are content-hashed by Vite — cache them hard.
    location ^~ /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Same-origin API -> windband-manager.
    # ${WM_API_URL} carries a scheme+authority only (no trailing path). Rendered
    # into a variable so nginx resolves the host at REQUEST time (resolver) and
    # never at config-parse time — an unresolvable name can't kill container
    # startup, and the ORIGINAL request URI is forwarded unchanged (no URI part
    # after $var), identical to `vite dev`'s /api proxy.
    location ^~ /api/ {
        # Docker built-in DNS by default; override with NGINX_RESOLVER per
        # environment (e.g. host network: use the resolver from /etc/resolv.conf).
        resolver ${NGINX_RESOLVER} valid=30s ipv6=off;
        set $wm_upstream ${WM_API_URL};
        proxy_pass $wm_upstream;
        proxy_http_version 1.1;
        # NOT Host: $host — a front proxy/edge in front of WM (or any public
        # https upstream) routes by the Host header and would 404 the SPA's
        # origin. With the variable-form proxy_pass, $proxy_host evaluates to
        # the WM_API_URL authority (e.g. windband-manager.railway.internal or
        # app.bandmanager.pl), which is exactly what the upstream expects.
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # Runtime environment for the SPA: rendered by nginx envsubst at container
    # start from the container environment (see deploy/nginx/env.js.template and
    # the Dockerfile ENV defaults). Served from conf.d so the source template
    # never ships in the web root; no-store so a redeploy with new values wins.
    location = /env.js {
        root /etc/nginx/conf.d;
        default_type application/javascript;
        add_header Cache-Control "no-store";
    }

    # Client-side routes (e.g. Keycloak /callback, deep links) fall back to the SPA.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
